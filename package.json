{
  "name": "invest-watchlist",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Private MCP watchlist connector for personal investment analysis.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "backup": "tsx src/backupCli.ts",
    "db:init": "tsx src/db/schema.ts",
    "docker:build": "docker build -t invest-watchlist .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env -e HTTP_HOST=0.0.0.0 invest-watchlist",
    "seed": "tsx src/seed.ts",
    "start": "npm run start:stdio",
    "start:stdio": "node dist/server.js",
    "start:http": "node dist/httpServer.js",
    "dev": "npm run dev:stdio",
    "dev:stdio": "tsx src/server.ts",
    "dev:http": "tsx src/httpServer.ts",
    "verify": "tsx src/verify.ts",
    "verify:prices": "tsx src/verifyPrices.ts",
    "verify:http": "npm run build && node dist/verifyHttp.js",
    "restore": "tsx src/restoreCli.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
